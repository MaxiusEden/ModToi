 "drama_option6109411": {
  "en": "Thank them for the gift",
  "pt": "Agradeça a eles pelo presente."
 },
 "drama_option6109412": {
  "en": "Claw",
  "pt": "Garra"
 },
 "drama_option6111031": {
  "en": "I'll buy it",
  "pt": "Eu vou comprar."
 },
 "drama_option6111032": {
  "en": "That's too expensive! It's practically a robbery!",
  "pt": "Isso é muito caro! É praticamente um roubo!"
 },
 "drama_option6112011": {
  "en": "This looks malignant. I better dispose of it.",
  "pt": "Isso parece maligno. É melhor eu me livrar disso."
 },
 "drama_option6112012": {
  "en": "This looks uncanny. Let me examine it first.",
  "pt": "Isso parece estranho. Deixe-me examiná-lo primeiro."
 },
 "drama_option6112013": {
  "en": "This is full of Fel energy. Allow me to use a spell to summon the spirit from within to learn of its history.",
  "pt": "Isto está repleto de energia de Fel. Deixe-me usar um feitiço para invocar o espírito que habita nele e conhecer sua história."
 },
 "drama_option6112014": {
  "en": "Mystic is this item, that I cannot fathom. I shall find one with the knowledge to identify it back in my Sect.",
  "pt": "Este item é místico, e não consigo compreendê-lo. Procurarei em minha Seita alguém com o conhecimento para identificá-lo."
 },
 "drama_option6112141": {
  "en": "This item and I must be fate-ordained. I shall pen the ending for this causality.",
  "pt": "Este item e eu devemos estar unidos pelo destino. Escreverei o final desta causalidade."
 },
 "drama_option6112142": {
  "en": "My knowledge of the Way skims only the surface. Continuing my investigation would bring danger to my life. I better leave the soul lamp for one more adept than me.",
  "pt": "Meu conhecimento sobre o Caminho é apenas superficial. Continuar minhas investigações colocaria minha vida em risco. É melhor deixar a lâmpada da alma para alguém mais capaz do que eu."
 },
 "drama_option6113061": {
  "en": "Help the Elder",
  "pt": "Ajude o Ancião."
 },
 "drama_option6113062": {
  "en": "Side with the Azurite Sect",
  "pt": "Fique do lado da Seita Azurita."
 },
 "drama_option6113063": {
  "en": "Observe on the side",
  "pt": "Observe ao lado."
 },
 "drama_option6113064": {
  "en": "Do not interrupt",
  "pt": "Não interrompa"
 },
 "drama_option6114031": {
  "en": "I've toiled through much to reach this place. I cannot leave empty-handed!",
  "pt": "Eu lutei muito para chegar até aqui. Não posso ir embora de mãos vazias!"
 },
 "drama_option6114032": {
  "en": "The light has been extinguished. Ends too, this string of events. I better leave.",
  "pt": "A luz se apagou. Esta sequência de eventos também chegou ao fim. É melhor eu ir embora."
 },
 "drama_option6114061": {
  "en": "An unknown rune symbol. It shimmers in grey and looks unusual.",
  "pt": "Um símbolo rúnico desconhecido. Ele brilha em cinza e parece incomum."
 },
 "drama_option6114062": {
  "en": "A beast bone exuding faint Qi. It likely belonged to a powerful beast, one that might even have conquered lands.",
  "pt": "Um osso de fera que emana um leve fluxo de Qi. Provavelmente pertenceu a uma fera poderosa, talvez até uma que tenha conquistado terras inteiras."
 },
 "drama_option6114063": {
  "en": "A small, colorful banner. Stare at it and you'll feel like you were surrounded by thousands of spirit wisps.",
  "pt": "Um pequeno estandarte colorido. Olhe para ele e você sentirá como se estivesse rodeado por milhares de fios de espírito."
 },
 "drama_option6114064": {
  "en": "I don't want anything else. I'll take this lamp as a remembrance.",
  "pt": "Não quero mais nada. Vou levar essa lâmpada como lembrança."
 },
 "drama_option6120031": {
  "en": "Ether Rocks!? This opportunity does not come lightly, I better trust it and try my luck.",
  "pt": "Pedras de Éter!? Esta é uma oportunidade rara; é melhor eu confiar nela e tentar a minha sorte."
 },
 "drama_option6120032": {
  "en": "Nothing is ever free. This smells of trouble. Farewell!",
  "pt": "Nada é de graça. Isso cheira a problemas. Adeus!"
 },
 "drama_option6120033": {
  "en": "I don't care about the artifacts, but you... look mighty tasty...",
  "pt": "Não me importo com os artefatos, mas você... parece delicioso..."
 },
 "drama_option6120034": {
  "en": "How dare you, you rabbit! Stealing my treasure? For this you will pay with your life!",
  "pt": "Como ousa, seu coelho! Roubando meu tesouro? Por isso, pagará com a própria vida!"
 },
